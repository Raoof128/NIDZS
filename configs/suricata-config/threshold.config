# Suricata Threshold Configuration
# Suppress noisy rules and control alert rates

# ================================================
# Rate Limiting
# ================================================
# Limit alerts to 5 per 60 seconds for port scans
threshold gen_id 1, sig_id 2200000, type threshold, track by_src, count 5, seconds 60

# Limit DNS tunneling alerts
threshold gen_id 1, sig_id 2300000, type threshold, track by_src, count 3, seconds 300

# ================================================
# Suppression Rules
# ================================================
# Suppress known false positives

# Example: Suppress specific rule for internal network
# suppress gen_id 1, sig_id 2210000, track by_src, ip 192.168.1.0/24

# Suppress DNS alerts for known DNS servers
# suppress gen_id 1, sig_id 2300001, track by_src, ip 8.8.8.8
# suppress gen_id 1, sig_id 2300001, track by_src, ip 8.8.4.4

# ================================================
# Event Filtering
# ================================================
# Reduce noise from high-volume events

# SSH brute force - only alert after 10 attempts in 60 seconds
event_filter gen_id 1, sig_id 2001219, type threshold, track by_dst, count 10, seconds 60

# HTTP scanning - only alert after 20 requests
event_filter gen_id 1, sig_id 2013028, type threshold, track by_src, count 20, seconds 60

# ================================================
# Custom Thresholds for Network IDS
# ================================================

# Port scanning - alert after 50 ports scanned
threshold gen_id 1, sig_id 2200001, type threshold, track by_src, count 50, seconds 30

# TLS anomalies - limit to 3 alerts per source per 5 minutes
threshold gen_id 1, sig_id 2400000, type threshold, track by_src, count 3, seconds 300

# SMB reconnaissance - limit alerts
threshold gen_id 1, sig_id 2500000, type threshold, track by_src, count 5, seconds 120

# ================================================
# Notes
# ================================================
# Threshold types:
#   - limit: Alert first N times then ignore
#   - threshold: Alert every N times
#   - both: Combine limit and threshold
#
# Track options:
#   - by_src: Track by source IP
#   - by_dst: Track by destination IP
#   - by_rule: Track globally per rule
